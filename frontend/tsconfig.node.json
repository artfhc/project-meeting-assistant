{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* Electron main runs in Node, not the browser — no DOM types */
    "types": ["node"],

    /* Strict but emit is handled by vite-plugin-electron */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "outDir": "dist/electron",
    "composite": true
  },
  "include": ["electron", "electron-builder.config.ts", "vite.config.ts"]
}
